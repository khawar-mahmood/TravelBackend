# ---- Server ----
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
# REQUIRED in production — must match your live site exactly:
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://robinholidays.co.uk,https://www.robinholidays.co.uk

# ---- Firebase / Firestore ----
# Easiest: paste the whole service-account JSON as one line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
#
# Or split it into three vars (often simpler on Vercel):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
#
# If all of these are left blank, the server uses an in-memory store for local
# dev only. Data resets on restart. Production (Vercel) requires credentials.

# ---- Admin login (for the /admin dashboard) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-secret

# ---- Homepage visa chat (optional, free) ----
# Makes Lisa reply with a real LLM. Without a key she still chats locally.
# Groq (recommended, free, no card): https://console.groq.com/keys
GROQ_API_KEY=
# Or Google AI Studio (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
