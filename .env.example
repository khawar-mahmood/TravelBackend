# ---- Server ----
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
# REQUIRED in production — must match your live site exactly:
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://robinholidays.co.uk,https://www.robinholidays.co.uk

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/robinholidays
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/robinholidays?retryWrites=true&w=majority
# If left blank, the server starts an in-memory MongoDB (requires: npm i -D mongodb-memory-server)
MONGODB_URI=

# ---- Admin login (for the /admin dashboard) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-secret
