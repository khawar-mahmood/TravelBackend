rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The Express API uses the Admin SDK, which bypasses these rules.
    // Deny all client SDK access so the website cannot talk to Firestore directly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}




git add .env.example .gitignore README.md app.js db.js index.js models/Inquiry.js package-lock.json package.json routes/inquiries.js seed.js firestore.rules
git commit -m "Migrate backend from MongoDB to Firestore"
git push origin main